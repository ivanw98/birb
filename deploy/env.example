# Copy to deploy/.env.production and fill in. Gitignored; never committed.
# Both the Railway and the Fly runbooks read their values from that copy, so the
# two hosts can never drift apart.

# --- runtime (server) --------------------------------------------------------
PORT=8080
DATABASE_URL='postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require'
SUPABASE_JWKS_URL='https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json'
SUPABASE_JWT_ISSUER='https://YOUR_PROJECT_REF.supabase.co/auth/v1'
SUPABASE_JWT_AUDIENCE='authenticated'
# Session mode pins one pooler conn per app conn; the free tier's pool is 15 and
# config.go defaults to 25. Stay under, leaving room for the migrate container.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2

# --- build (baked into the JS bundle; public by design) ----------------------
VITE_SUPABASE_URL='https://YOUR_PROJECT_REF.supabase.co'
VITE_SUPABASE_PUBLISHABLE_KEY='sb_publishable_YOUR_KEY_HERE'
