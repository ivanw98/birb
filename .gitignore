# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.zed

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum
tools/devauth/dev-key.pem

# env files — every suffix, every directory. Committed examples must be opted back in.
.env*
!.env.example

# Node / TypeSpec toolchain (api/ compiles the spec; deps are not committed)
node_modules/
api/tsp-output/

# Editor/IDE
# .idea/
# .vscode/
frontend-course/
